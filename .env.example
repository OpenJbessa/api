# ---------------------------------------------------------------------------
# API jbessa.tech — variables d'environnement.
#
# Valeurs par défaut : l'environnement local de docker-compose.yml. En
# production, ces variables viennent du ConfigMap `api-config` et du Secret
# `api-secrets` du dépôt gitops (cf. DEPLOY.md) ; ce fichier n'y est jamais lu.
#
# AUCUN SECRET RÉEL ICI. Les secrets de production sont chiffrés (SOPS/age)
# dans gitops. Les rares valeurs renseignées ci-dessous ne protègent que des
# conteneurs locaux jetables.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------

# Sert de base aux préfixes dérivés (cookie de session, cache) quand ceux-ci ne
# sont pas fixés explicitement.
APP_NAME=api
APP_ENV=local
# Généré par `docker compose exec app php artisan key:generate`. Secret en
# production : une fuite permet de forger des cookies de session.
APP_KEY=
APP_DEBUG=true
# URL publique de l'API elle-même (production : https://api.jbessa.tech).
APP_URL=http://localhost:8000

# Front Nuxt : cible des redirections après connexion OAuth
# ({FRONTEND_URL}/demo). Production : https://jbessa.tech
FRONTEND_URL=http://localhost:3000

# Messages d'erreur et de validation en français.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Journaux --------------------------------------------------------------

# stderr : un conteneur n'écrit pas de fichier journal, le système de
# fichiers est en lecture seule en production.
LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# --- PostgreSQL ------------------------------------------------------------

DB_CONNECTION=pgsql
# Nom du service compose. Production : postgres-rw.data.svc.cluster.local
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
# Mot de passe du conteneur local. Secret en production (généré par CNPG).
DB_PASSWORD=app

# --- Redis -----------------------------------------------------------------

REDIS_CLIENT=phpredis
# Nom du service compose. Production : redis.data.svc.cluster.local
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
# Base 0 : sessions, verrous, stream, compteurs. Base 1 : cache. Le Redis de
# production n'a que ces deux bases (databases 2).
REDIS_DB=0
REDIS_CACHE_DB=1
# Vide, et c'est voulu : KEDA interroge des clés écrites en dur (le stream
# demo:events). Avec un préfixe, il lirait une clé inexistante sans erreur.
REDIS_PREFIX=

# --- Session, cache, file --------------------------------------------------

# Tout en Redis : aucun état dans les pods.
SESSION_DRIVER=redis
# En minutes. Doit rester au-delà de la durée de vie d'un compte de démo.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production : .jbessa.tech, pour que le front (jbessa.tech) et l'API
# (api.jbessa.tech) partagent le cookie. En local : vide (localhost).
SESSION_DOMAIN=
# Production : true (HTTPS obligatoire).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Domaines du front dont les requêtes sont authentifiées par cookie (Sanctum,
# mode SPA). Production : jbessa.tech
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. Une seule politique CORS, avec cookies : jamais `*`.
# Production : https://jbessa.tech
# Site de documentation (Starlight) : son astro.config déclare
# https://jbessa.tech, déjà couvert. S'il est servi depuis une autre origine
# et appelle /status depuis le navigateur, l'ajouter ici, par exemple :
#   CORS_ALLOWED_ORIGINS=https://jbessa.tech,https://docs.jbessa.tech
CORS_ALLOWED_ORIGINS=http://localhost:3000

CACHE_STORE=redis

# Aucune file Laravel : il n'y a pas de queue:work déployé. Ne pas changer sans
# ajouter la charge correspondante au budget mémoire (cf. docs/adr/).
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# L'API n'envoie aucun e-mail.
MAIL_MAILER=log

# --- Sources de la plateforme (/status, /infrastructure, /scaling) ---------

# Valeurs par défaut : les noms de service du cluster. Les redéfinir n'a
# d'intérêt qu'en développement, derrière un `kubectl port-forward`.
# GATUS_URL=http://gatus.observability.svc.cluster.local:8080
# VICTORIAMETRICS_URL=http://vmsingle.observability.svc.cluster.local:8428

# --- Démo à comptes éphémères ----------------------------------------------

# Durée de vie d'un compte, en minutes. Le compte et toutes ses traces sont
# supprimés ensuite.
DEMO_TTL_MINUTES=30
# Comptes actifs simultanés au-delà desquels la création répond 503.
DEMO_MAX_ACTIVE=50
# Élévations d'accès temporaires autorisées par compte.
DEMO_MAX_ELEVATIONS=3
# Intervalle, en secondes, du balayage des comptes expirés abandonnés. Il tourne
# dans la boucle du générateur (demo:emit-events) : c'est le délai maximal entre
# l'expiration d'un compte et la suppression de ses traces.
DEMO_PURGE_INTERVAL_SECONDS=300
# Créations de comptes par heure et par adresse IP (connexion anonyme et
# départs OAuth confondus). Pas trop bas : un NAT d'entreprise partage une IP.
DEMO_SIGNUP_PER_HOUR=10

# Connexion OAuth. Identifiants d'application : SECRETS en production.
# Scopes minimaux, aucun e-mail ni jeton OAuth n'est stocké.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Séquence KEDA (stream Redis demo:events) ------------------------------

# Débit de fond du générateur, en messages par seconde, hors rafale.
DEMO_BACKGROUND_RATE=2
# Rafale déclenchée par POST /demo/burst : débit et durée.
DEMO_BURST_RATE=150
DEMO_BURST_SECONDS=60
# Longueur approximative maximale du stream (XADD MAXLEN ~) : borne la mémoire
# que le stream peut prendre dans Redis.
DEMO_STREAM_MAXLEN=10000
# Traitement simulé par événement dans le consommateur, en millisecondes.
DEMO_WORK_MS=20

# Jeton attendu par GET /metrics dans `Authorization: Bearer …` (vmagent).
# SECRET en production. Vide, ou mauvais jeton : /metrics répond 404.
METRICS_TOKEN=
